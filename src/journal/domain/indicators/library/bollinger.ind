# Bollinger Bands
length = input(20, min=2, max=500, title="Length")
mult = input(2.0, min=0.1, max=5.0, step=0.1, title="StdDev")
plot(bb_upper(close, length, mult), title="Upper", color="mark-sky", width=1)
plot(bb_mid(close, length, mult), title="Basis", color="muted", width=1)
plot(bb_lower(close, length, mult), title="Lower", color="mark-sky", width=1)

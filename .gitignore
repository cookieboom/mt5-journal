data/
cache/

# A store that landed anywhere but data/. `journal backup --dest ./x.db` and
# `journal restore` both write where you ran them, and a `git add -A` in that
# directory stages a 62 MB file with the real login inside it. `origin` is
# PUBLIC and rule 10 has been broken twice; this one nearly made it three.
# No .db file has ever been tracked here — fixtures are JSON.
*.db
*.db-wal
*.db-shm

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.pytest_cache/
*.egg-info/

# Personal, machine-local Claude Code config (keep .claude/settings.json shared)
.claude/settings.local.json

# graphify output is regenerated on demand (`graphify update .`), not tracked —
# the graph is non-deterministic and churned every commit via the hook. Kept
# local so queries work; out of git so it stops dirtying the tree.
graphify-out/
.superpowers/

# Vitest local run cache
.vite/

.worktrees/
